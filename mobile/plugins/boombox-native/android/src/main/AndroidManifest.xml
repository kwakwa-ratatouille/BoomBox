<?xml version="1.0" encoding="utf-8"?>
<!-- yt-dlp (Python) a besoin que ses bibliothèques natives soient extraites à l'installation -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mise à jour de l'appli depuis l'appli (bouton « Mettre à jour ») -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Service de lecture : la notification du lecteur reste visible (Xiaomi, autres applis qui jouent du son) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:extractNativeLibs="true">
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" android:value="app.boombox.nativeplugin.CastOptionsProvider" />
        <service android:name="app.boombox.nativeplugin.PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
