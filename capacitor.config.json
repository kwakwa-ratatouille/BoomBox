{
  "appId": "app.boombox.music",
  "appName": "Boombox",
  "webDir": "public",
  "backgroundColor": "#131019",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": true
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#131019",
    "allowsLinkPreview": false
  },
  "android": {
    "backgroundColor": "#131019",
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false }
  }
}
