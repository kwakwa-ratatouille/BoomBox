{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "headers": [{ "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "max-age=300" }] }, { "source": "/app-update/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }, { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
